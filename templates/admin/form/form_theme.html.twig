{% extends '@EasyAdmin/crud/form_theme.html.twig' %}

{% block ea_fileupload_widget %}
    {% set currentFiles = form.vars.data %}
    {% if currentFiles is not iterable %}
        {% set currentFiles = currentFiles ? [currentFiles] : [] %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block hf_html_editor_widget %}
    <div class="hf-html-editor" data-hf-html-editor>
        <div class="hf-html-editor__toolbar" role="toolbar" aria-label="Форматирование">
            <button type="button" class="hf-html-editor__btn" data-cmd="bold" title="Жирный"><strong>B</strong></button>
            <button type="button" class="hf-html-editor__btn" data-cmd="italic" title="Курсив"><em>I</em></button>
            <button type="button" class="hf-html-editor__btn" data-cmd="underline" title="Подчёркивание"><u>U</u></button>
            <span class="hf-html-editor__sep"></span>
            <button type="button" class="hf-html-editor__btn" data-cmd="h3" title="Заголовок 3">H3</button>
            <button type="button" class="hf-html-editor__btn" data-cmd="h4" title="Заголовок 4">H4</button>
            <button type="button" class="hf-html-editor__btn" data-cmd="p" title="Абзац">P</button>
            <span class="hf-html-editor__sep"></span>
            <button type="button" class="hf-html-editor__btn" data-cmd="ul" title="Список">•</button>
            <button type="button" class="hf-html-editor__btn" data-cmd="ol" title="Нумерация">1.</button>
            <button type="button" class="hf-html-editor__btn" data-cmd="link" title="Ссылка">🔗</button>
            <button type="button" class="hf-html-editor__btn" data-cmd="removeFormat" title="Очистить">⌫</button>
            <span class="hf-html-editor__sep"></span>
            <button type="button" class="hf-html-editor__btn" data-cmd="toggleSource" title="HTML-код">&lt;/&gt;</button>
        </div>
        <div class="hf-html-editor__surface" contenteditable="true" role="textbox" aria-multiline="true"></div>
        <textarea {{ block('widget_attributes') }} hidden>{{ value }}</textarea>
    </div>
{% endblock %}
