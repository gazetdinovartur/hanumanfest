{% extends 'email/base.html.twig' %}

{% block title %}Хануман Фест — предоплата принята{% endblock %}

{% block preheader %}Осталось оплатить {{ remainingAmount|number_format(0, ',', ' ') }} ₽ — ссылка внутри.{% endblock %}

{% block content %}
    <p style="margin:0 0 16px;">Здравствуйте{% if name %}, {{ name }}{% endif %}!</p>
    <p style="margin:0 0 16px;">Спасибо, предоплата принята.</p>
    <p style="margin:0 0 8px;"><strong>Оплачено:</strong> {{ paidAmount|number_format(0, ',', ' ') }} ₽</p>
    <p style="margin:0 0 8px;"><strong>Осталось:</strong> {{ remainingAmount|number_format(0, ',', ' ') }} ₽</p>
    <p style="margin:0 0 24px;"><strong>Всего по заявке:</strong> {{ totalAmount|number_format(0, ',', ' ') }} ₽</p>
    <p style="margin:0 0 24px;text-align:center;">
        <a href="{{ payUrl }}" style="display:inline-block;background:#f65414;color:#ffffff;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:4px;">Оплатить остаток</a>
    </p>
    <p style="margin:0;font-size:13px;line-height:1.5;">
        Если кнопка не открывается, скопируйте ссылку:<br>
        <a href="{{ payUrl }}" style="color:#f65414;word-break:break-all;">{{ payUrl }}</a>
    </p>
{% endblock %}
