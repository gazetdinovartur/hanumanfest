{% extends 'email/base.html.twig' %}

{% block title %}Хануман Фест — вы зарегистрировались{% endblock %}

{% block preheader %}Вы зарегистрировались на Хануман Фест. Осталось {{ remainingAmount|number_format(0, ',', ' ') }} ₽.{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;">Здравствуйте{% if name %}, {{ name }}{% endif %}!</p>
    <p style="margin:0 0 24px;font-size:20px;line-height:1.4;font-weight:700;">Вы зарегистрировались и внесли предоплату за участие в Хануман Фест!</p>

    {% if details is defined and details %}
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 24px;border-collapse:collapse;">
        {% for row in details %}
        <tr>
            <td style="padding:10px 12px 10px 0;border-bottom:1px solid #eee;color:#6b6b6b;width:42%;vertical-align:top;">{{ row.label }}</td>
            <td style="padding:10px 0;border-bottom:1px solid #eee;font-weight:600;vertical-align:top;">{{ row.value }}</td>
        </tr>
        {% endfor %}
        <tr>
            <td style="padding:10px 12px 10px 0;border-bottom:1px solid #eee;color:#6b6b6b;">Стоимость</td>
            <td style="padding:10px 0;border-bottom:1px solid #eee;font-weight:600;">{{ totalAmount|number_format(0, ',', ' ') }} ₽</td>
        </tr>
        <tr>
            <td style="padding:10px 12px 10px 0;border-bottom:1px solid #eee;color:#6b6b6b;">Оплачено</td>
            <td style="padding:10px 0;border-bottom:1px solid #eee;font-weight:600;">{{ paidAmount|number_format(0, ',', ' ') }} ₽</td>
        </tr>
        <tr>
            <td style="padding:10px 12px 10px 0;color:#f65414;">Осталось</td>
            <td style="padding:10px 0;color:#f65414;font-weight:700;">{{ remainingAmount|number_format(0, ',', ' ') }} ₽</td>
        </tr>
    </table>
    {% endif %}

    {% if contacts is defined and contacts %}
    <p style="margin:0 0 12px;font-weight:700;">Если есть вопросы, напишите нам:</p>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 28px;">
        {% for contact in contacts %}
            {% if contact.href starts with 'tel:' or contact.href starts with 'mailto:' %}
        <tr>
            <td style="padding:4px 0;">
                <a href="{{ contact.href }}" style="color:#f65414;text-decoration:none;font-weight:500;">{{ contact.label }}</a>
            </td>
        </tr>
            {% endif %}
        {% endfor %}
        {% set socials = contacts|filter(c => c.href starts with 'http') %}
        {% if socials %}
        <tr>
            <td style="padding:12px 0 0;">
                {% for contact in socials %}
                    <a href="{{ contact.href }}" style="color:#f65414;text-decoration:none;font-weight:500;">{{ contact.label }}</a>{% if not loop.last %}<span style="color:#c8c8c8;padding:0 10px;">·</span>{% endif %}
                {% endfor %}
            </td>
        </tr>
        {% endif %}
    </table>
    {% endif %}

    <p style="margin:0 0 16px;">Остаток можно внести сейчас или позже по этой ссылке.</p>
    <p style="margin:0 0 24px;text-align:center;">
        <a href="{{ payUrl }}" style="display:inline-block;background:#f65414;color:#ffffff;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:4px;">Оплатить остаток</a>
    </p>
    <p style="margin:0;font-size:13px;line-height:1.5;">
        Если кнопка не открывается, скопируйте ссылку:<br>
        <a href="{{ payUrl }}" style="color:#f65414;word-break:break-all;">{{ payUrl }}</a>
    </p>
{% endblock %}
