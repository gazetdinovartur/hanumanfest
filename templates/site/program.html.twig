{% extends 'site/base.html.twig' %}

{% block title %}Программа — Хануман Фест{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/site/hf-schedule.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<main class="page-content py-5">
    <div class="container hf-schedule-page">
        <h1 class="text-brand-main text-center mb-4">Программа фестиваля</h1>
        <div class="hf-schedule" data-hf-schedule data-layout="full">
            <div class="hf-schedule__loading text-center py-4">
                <div class="spinner-border text-brand-main" role="status">
                    <span class="visually-hidden">Загрузка…</span>
                </div>
            </div>
        </div>
        <p class="hf-schedule__note text-muted text-center small mt-3 mb-0">
            Возможны корректировки в расписании и расширение программы.
        </p>
    </div>
</main>
{% endblock %}

{% block javascripts %}
<script>
    window.hfSchedule = { apiBase: '/api' };
</script>
<script src="{{ asset('assets/site/hf-schedule.js') }}"></script>
{% endblock %}
