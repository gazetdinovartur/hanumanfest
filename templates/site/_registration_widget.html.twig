<div class="container py-2" data-uae-widget="registration" >
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-danger d-none mb-2" data-uae-error></div>
            <p class="small text-muted mb-2 hf-reg-status" data-uae-status></p>

            <form class="row g-3" data-uae-form>
                <div class="col-md-6">
                    <label class="form-label">Имя</label>
                    <input class="form-control" name="name" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="email" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Телефон</label>
                    <input class="form-control" type="tel" name="phone" placeholder="+7900..." required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Вариант участия</label>
                    <select class="form-select" name="participationOptionId" required></select>
                </div>
                <div class="col-12 d-none" data-uae-conditional="tent-roommate">
                    <label class="form-label" for="hf-tent-roommate">С кем будете проживать в палатке</label>
                    <textarea class="form-control" id="hf-tent-roommate" name="tentRoommate" rows="2"></textarea>
                </div>
                <div class="col-12 d-none" data-uae-conditional="house-booking">
                    <div class="form-label">Ссылка на бронирование домика</div>
                    <p class="mb-0">
                        <a href="https://www.helloferma.ru/" class="contact-link" target="_blank" rel="noopener">Перейти на сайт</a>
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Количество взрослых</label>
                    <input class="form-control" type="number" min="1" step="1" name="adultsCount" value="1" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Количество детей до 16 лет</label>
                    <input class="form-control" type="number" min="0" step="1" name="childrenCount" value="0">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Вариант оплаты</label>
                    <select class="form-select" name="paymentFactor">
                        <option value="0.5">Предоплата 50%</option>
                        <option value="1">Полная оплата</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="transferIncluded" id="hf-transfer">
                        <label class="form-check-label" for="hf-transfer">Трансфер туда-обратно (+600 ₽/чел)</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border rounded p-3 bg-light hf-reg-pricing">
                        <div>Итого: <strong data-uae-total>—</strong></div>
                        <div>К оплате сейчас: <strong data-uae-now>—</strong></div>
                        <div class="small text-muted hf-reg-meta" data-uae-meta>&nbsp;</div>
                    </div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-brand-main text-white fw-bold px-4 py-2" data-uae-submit>Оплатить</button>
                </div>
            </form>
        </div>
    </div>
</div>
