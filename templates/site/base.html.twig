<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light only">
    <title>{% block title %}Хануман Фест{% endblock %}</title>
    {% if settings is defined and settings and settings.logoPath %}
        <meta property="og:image" content="{{ absolute_url(asset(public_upload_url(settings.logoPath)|default(settings.logoPath))) }}">
        <link rel="icon" href="{{ asset(public_upload_url(settings.logoPath)|default(settings.logoPath)) }}">
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('assets/site/hf-lightbox.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/site/style.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header id="header">
    <nav class="container d-flex align-items-center justify-content-between py-2">
        <!-- Логотип -->
        <div class="nav-logo">
            <a href="{{ path('site_home') }}">
                {% if settings and settings.logoPath %}
                    <img src="{{ asset(public_upload_url(settings.logoPath)|default(settings.logoPath)) }}" class="custom-logo" alt="{{ settings.siteName|default('Хануман Фест') }}">
                {% else %}
                    <span class="site-title">Хануман Фест</span>
                {% endif %}
            </a>
        </div>
        <a href="{{ path('site_home') }}#about" class="nav-link d-none d-md-block">О фестивале</a>
        <a href="{{ path('site_home') }}#program" class="nav-link d-none d-md-block">Программа</a>
        <a href="{{ path('site_home') }}#guests" class="nav-link d-none d-md-block">Специальные гости</a>
        <a href="{{ path('site_home') }}#masters" class="nav-link d-none d-md-block">Мастера и практики</a>
        <a href="{{ path('site_home') }}#cost" class="nav-link d-none d-md-block">Ценность</a>
        <a href="{{ path('site_home') }}#register" class="nav-link d-none d-md-block">Регистрация</a>
        <a href="{{ path('site_home') }}#contacts" class="nav-link d-none d-md-block">Контакты</a>
        <!-- Гамбургер -->
        <button class="navbar-toggler d-md-none ms-auto" type="button"
                data-bs-toggle="collapse" data-bs-target="#mobileMenu"
                aria-controls="mobileMenu" aria-expanded="false" aria-label="Переключить меню">
            <span class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>
    </nav>

    <!-- Подложка -->
    <div class="mobile-menu-overlay"></div>

    <!-- Мобильное меню -->
    <div class="collapse mobile-menu p-4 d-md-none" id="mobileMenu">
        <ul class="nav flex-column gap-3 mobile-menu-list">
            <li><a href="{{ path('site_home') }}#about"><span>О фестивале</span></a></li>
            <li><a href="{{ path('site_home') }}#program"><span>Программа</span></a></li>
            <li><a href="{{ path('site_home') }}#guests"><span>Специальные гости</span></a></li>
            <li><a href="{{ path('site_home') }}#masters"><span>Мастера и практики</span></a></li>
            <li><a href="{{ path('site_home') }}#cost"><span>Ценность</span></a></li>
            <li><a href="{{ path('site_home') }}#register"><span>Регистрация</span></a></li>
            <li><a href="{{ path('site_home') }}#contacts"><span>Контакты</span></a></li>
        </ul>
    </div>
</header>

{% block body %}{% endblock %}

{% set footerBg = settings is defined and settings and settings.footerBackgroundPath ? asset(settings.footerBackgroundPath) : null %}
{% set footerContactsRaw = settings is defined and settings ? settings.contactsHtml : null %}
<footer class="site-footer"{% if footerBg %} style="background-image: url('{{ footerBg }}');"{% endif %}>
    <div class="footer-overlay"></div>
    <div class="footer-container">
        <div class="footer-right">
            <nav class="footer-menu">
                <ul class="footer-menu-items">
                    {% for page in footerPages|default([]) %}
                        <li><a href="{{ path('site_page', {slug: page.slug}) }}">{{ page.title }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
            <div class="footer-contacts" id="contacts">
                {% for link in footer_contact_links(footerContactsRaw) %}
                    <a href="{{ link.href }}">{{ link.label }}</a>
                {% endfor %}
            </div>
            <div class="footer-socials">
                {% for social in footer_social_links(footerContactsRaw) %}
                    <a href="{{ social.url }}" class="footer-social footer-{{ social.name }}" target="_blank" rel="noopener">
                        <img src="{{ asset('assets/site/icons/' ~ social.name ~ '.svg') }}" alt="{{ social.name|upper }}">
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <p>© {{ "now"|date('Y') }} {% if settings is defined and settings %}{{ settings.siteName }}{% else %}Хануман Фест{% endif %}</p>
        {% if settings is defined and settings and settings.companyInfo %}
            <p>{{ settings.companyInfo|nl2br }}</p>
        {% endif %}
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('assets/site/script.js') }}"></script>
<script src="{{ asset('assets/site/hf-gallery.js') }}"></script>
<script src="{{ asset('assets/site/hf-lightbox.js') }}"></script>
<script>
    const scrollUpBtn = document.getElementById("scroll-up");
    const header = document.getElementById("header");
    if (scrollUpBtn && header) {
        window.addEventListener("scroll", () => {
            scrollUpBtn.classList.toggle("show", window.scrollY > 300);
            header.classList.toggle("header-background--white", window.scrollY > 100);
            header.classList.toggle("fixed-top", window.scrollY > 500);
        });
    }
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
