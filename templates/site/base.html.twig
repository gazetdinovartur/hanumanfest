<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light only">
    <title>{% block title %}Хануман Фест{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('assets/site/style.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header id="header">
    <nav class="container d-flex align-items-center justify-content-between py-2">
        <div class="nav-logo">
            <a href="{{ path('site_home') }}" class="site-title text-brand-main fw-bold text-decoration-none">Хануман Фест</a>
        </div>
        <a href="{{ path('site_home') }}#about" class="nav-link d-none d-md-block">О фестивале</a>
        <a href="{{ path('site_program') }}" class="nav-link d-none d-md-block">Программа</a>
        <a href="{{ path('site_home') }}#cost" class="nav-link d-none d-md-block">Ценность</a>
        <a href="{{ path('site_registration') }}" class="nav-link d-none d-md-block">Регистрация</a>
        <button class="navbar-toggler d-md-none ms-auto" type="button"
                data-bs-toggle="collapse" data-bs-target="#mobileMenu"
                aria-controls="mobileMenu" aria-expanded="false" aria-label="Меню">
            <span class="hamburger"><span></span><span></span><span></span></span>
        </button>
    </nav>
    <div class="mobile-menu-overlay"></div>
    <div class="collapse mobile-menu p-4 d-md-none" id="mobileMenu">
        <ul class="nav flex-column gap-3 mobile-menu-list">
            <li><a href="{{ path('site_home') }}#about">О фестивале</a></li>
            <li><a href="{{ path('site_program') }}">Программа</a></li>
            <li><a href="{{ path('site_home') }}#cost">Ценность</a></li>
            <li><a href="{{ path('site_registration') }}">Регистрация</a></li>
        </ul>
    </div>
</header>

{% block body %}{% endblock %}

<footer class="py-4 text-center text-muted small">
    <div class="container">
        <p class="mb-1">Хануман Фест</p>
        <p class="mb-0">
            <a class="contact-link" href="https://vk.com/skazka_108">VK</a>
            ·
            <a class="contact-link" href="https://t.me/+79222108041">Telegram</a>
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('assets/site/script.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
