{% set footerContactsRaw = settings is defined and settings ? settings.contactsHtml : null %}
{% set feedbackContacts = footer_feedback_contacts(footerContactsRaw) %}
{% if feedbackContacts %}
    {% set directContacts = [] %}
    {% set socialContacts = [] %}
    {% for contact in feedbackContacts %}
        {% if contact.href starts with 'tel:' or contact.href starts with 'mailto:' %}
            {% set directContacts = directContacts|merge([contact]) %}
        {% else %}
            {% set socialContacts = socialContacts|merge([contact]) %}
        {% endif %}
    {% endfor %}
<div class="hf-return-contacts">
    <p class="hf-return-contacts__title">Если есть вопросы, напишите нам:</p>
    {% if directContacts %}
    <ul class="hf-return-contacts__list">
        {% for contact in directContacts %}
            <li>
                <a class="hf-return-contacts__link" href="{{ contact.href }}">{{ contact.label }}</a>
            </li>
        {% endfor %}
    </ul>
    {% endif %}
    {% if socialContacts %}
    <p class="hf-return-contacts__socials">
        {% for contact in socialContacts %}
            <a class="hf-return-contacts__link" href="{{ contact.href }}" target="_blank" rel="noopener">{{ contact.label }}</a>
        {% endfor %}
    </p>
    {% endif %}
</div>
{% endif %}
