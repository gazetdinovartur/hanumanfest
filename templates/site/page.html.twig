{% extends 'site/base.html.twig' %}

{% block title %}{{ page.title }} — Хануман Фест{% endblock %}

{% block body %}
<main class="page-content container">
    <h1 class="text-brand-main mb-3">{{ page.title }}</h1>
    {{ page.contentHtml|raw }}
</main>

{% if page.template.value == 'kitchen' and page.kitchenVideos is not empty %}
<section class="promo-grid">
    {% for videoPath in page.kitchenVideos %}
        <div class="promo-card">
            <video src="{{ asset(videoPath) }}" {% if loop.first %}autoplay {% endif %}muted loop controls playsinline preload="metadata"></video>
        </div>
    {% endfor %}
</section>
{% endif %}
{% endblock %}
