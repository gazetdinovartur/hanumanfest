# Скопируйте в .env и заполните локально / на сервере.
# Файл .env в git не коммитится. Секреты только локально.

APP_ENV=dev
APP_SECRET=change-me

DEFAULT_URI=https://хануманфест.рф

DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0&charset=utf8mb4"

###> Hanuman Fest ###
APP_URL="https://хануманфест.рф"
FRONTEND_URL="https://хануманфест.рф"
CORS_ALLOW_ORIGIN="https://хануманфест.рф"
###< Hanuman Fest ###

# Prod: обязательно заполнить
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Лист регистраций (ссылка на таблицу). Экспорт — Google Sheets API.
REGISTRATION_SHEET_URL=https://docs.google.com/spreadsheets/d/1H5bzA14-b7vjZBjo6lz7ZyIlGcoZc26fWVs0aL31uV0/edit
# Тестовый режим: отдельная таблица, не боевой лист
REGISTRATION_SHEET_URL_TEST=
# JSON-ключ service account или путь к файлу. Таблицу расшарить на client_email как редактор.
GOOGLE_SHEETS_CREDENTIALS=
# Prod: CSV export URL программы для app:import:schedule (cron)
SCHEDULE_SHEET_URL=

# Prod: реальный SMTP (иначе письма о доплате не уйдут)
MAILER_DSN=null://null
MAILER_FROM="noreply@hanumanfest.ru"
MAILER_FROM_NAME="Хануман Фест"

# Prod: сменить на сильный пароль
ADMIN_PASSWORD=TempAdmin!2026
